{
  "name": "huan",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @huan/harness dev",
    "build": "pnpm --filter @huan/harness build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "lingui:extract": "pnpm --filter @huan/harness lingui:extract",
    "lingui:compile": "pnpm --filter @huan/harness lingui:compile"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "typescript": "catalog:",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
